# The combined SDR build variant: SDR, Bluetooth, Zigbee and Thread in one
# image.
#
# It links: the whole image still fits below the capture bank (0x40840000),
# with about 2 KB to spare (_heap_start = 0x4083f750). What it costs is heap.
# The bank takes the 128 KB block out of it, so only 2 KiB of heap is left
# below the bank and 113 KiB above it. Measured on hardware (2026-11-25):
#
#   idle, Wi-Fi up           59 KB free
#   SDR capture              42 KB minimum
#   Zigbee On/Off Switch      5 KB minimum
#   BLE Trackers scan         4 KB minimum
#
# Every app works on its own, but Zigbee and BLE run a few KB from running
# out, so a busy scan or SD logging can fail. That is why this is not the
# default: use it when one device has to carry all of them. The stand-alone
# SDR variant (sdkconfig.sdr) keeps the stacks out and has 50 KiB more heap.
#
# Build it with:
#   idf.py @profiles/sdr-full/profile build
#
# or, from the Makefile:
#   make build-sdr-full

# The capture bank is reserved and the image is capped below it.
CONFIG_SDR_ENABLE=y

# The stacks stay in (they are already on in sdkconfig.defaults; pinned here
# so the intent of this variant is explicit).
CONFIG_MININO_ZIGBEE_STACK=y
CONFIG_MININO_OPENTHREAD_STACK=y
